[{"_id":"69a65d56ff996647cc9a6c55","command":"ls","category":"File System","description":"List directory contents.","examples":["ls -lah","ls -lt /var/log","ls -R ~/projects | grep \".py\""],"flags":[{"flag":"-l","meaning":"Long format (permissions, size, date)"},{"flag":"-a","meaning":"Show hidden files (. files)"},{"flag":"-h","meaning":"Human-readable sizes (KB, MB)"},{"flag":"-R","meaning":"Recursive listing"},{"flag":"-t","meaning":"Sort by modification time, newest first"},{"flag":"-S","meaning":"Sort by file size"},{"flag":"--color","meaning":"Colorize output"}],"synopsis":"ls [OPTIONS] [PATH]","tip":"Alias: alias ll=\"ls -lah --color=auto\"","updatedAt":"2026-03-03T04:02:30.073Z"},{"_id":"69a65d56ff996647cc9a6c56","command":"find","category":"File System","description":"Search for files recursively by name, type, size, time, and more.","examples":["find . -name \"*.log\" -mtime +30 -delete","find /etc -type f -name \"*.conf\" -exec grep -l \"port\" {} \\;","find . -size +100M -type f"],"flags":[{"flag":"-name","meaning":"Match filename (glob, case-sensitive)"},{"flag":"-iname","meaning":"Case-insensitive name match"},{"flag":"-type f","meaning":"Files only"},{"flag":"-type d","meaning":"Directories only"},{"flag":"-size +10M","meaning":"Larger than 10 MB"},{"flag":"-mtime -7","meaning":"Modified in last 7 days"},{"flag":"-exec CMD {} \\;","meaning":"Run CMD on each result"},{"flag":"-maxdepth N","meaning":"Only descend N levels"}],"synopsis":"find [PATH] [EXPR]","tip":"Use -exec rm {} \\; with extreme care. Test with -print first.","updatedAt":"2026-03-03T04:02:30.483Z"},{"_id":"69a65d56ff996647cc9a6c57","command":"cp","category":"File System","description":"Copy files and directories.","examples":["cp -rp /src/dir /dst/","cp -u *.conf ~/.config/","cp file{,.bak}  # quick backup"],"flags":[{"flag":"-r","meaning":"Recursive (for directories)"},{"flag":"-p","meaning":"Preserve timestamp, permissions, owner"},{"flag":"-u","meaning":"Only copy if src is newer than dst"},{"flag":"-v","meaning":"Verbose, show each file copied"},{"flag":"-i","meaning":"Prompt before overwrite"},{"flag":"--sparse=always","meaning":"Copy sparse files efficiently"}],"synopsis":"cp [OPTIONS] SRC DEST","tip":"cp file{,.bak} is a brace-expansion trick to quickly back up a file.","updatedAt":"2026-03-03T04:02:30.531Z"},{"_id":"69a65d56ff996647cc9a6c58","command":"mv","category":"File System","description":"Move or rename files and directories.","examples":["mv old_name.txt new_name.txt","mv *.log /var/archive/","mv -v dir/ /mnt/backup/"],"flags":[{"flag":"-v","meaning":"Verbose"},{"flag":"-i","meaning":"Prompt before overwrite"},{"flag":"-n","meaning":"Never overwrite"}],"synopsis":"mv [OPTIONS] SRC DEST","tip":"mv across filesystems copies then deletes. For large transfers, rsync is safer.","updatedAt":"2026-03-03T04:02:30.581Z"},{"_id":"69a65d56ff996647cc9a6c59","command":"rm","category":"File System","description":"Remove files or directories.","examples":["rm -rf /tmp/build","rm -i *.log","find . -name \"*.pyc\" -delete  # safer than rm"],"flags":[{"flag":"-r","meaning":"Recursive (required for dirs)"},{"flag":"-f","meaning":"Force, ignore non-existent, no prompt"},{"flag":"-i","meaning":"Interactive, prompt each file"},{"flag":"-v","meaning":"Verbose"}],"synopsis":"rm [OPTIONS] FILE","tip":"Never run rm -rf / with --no-preserve-root. Use trash-cli for safer deletes.","updatedAt":"2026-03-03T04:02:30.634Z"},{"_id":"69a65d56ff996647cc9a6c5a","command":"mkdir","category":"File System","description":"Create directories.","examples":["mkdir -p ~/projects/{go,python,rust}/src","mkdir -m 700 ~/.secrets"],"flags":[{"flag":"-p","meaning":"Create parent dirs as needed, no error if exists"},{"flag":"-v","meaning":"Print each created dir"},{"flag":"-m 755","meaning":"Set permissions at creation"}],"synopsis":"mkdir [OPTIONS] DIR","tip":"mkdir -p a/b/c creates the full path in one shot.","updatedAt":"2026-03-03T04:02:30.676Z"},{"_id":"69a65d56ff996647cc9a6c5b","command":"ln","category":"File System","description":"Create hard links or symbolic links.","examples":["ln -s /etc/nginx/nginx.conf ~/nginx.conf","ln -sf $(which python3) /usr/local/bin/python"],"flags":[{"flag":"-s","meaning":"Create a symbolic (soft) link"},{"flag":"-f","meaning":"Remove existing dest file"},{"flag":"-v","meaning":"Verbose"},{"flag":"-r","meaning":"Create symlink relative to link location"}],"synopsis":"ln [-s] TARGET LINK","tip":"Symlinks point to a path. Hard links point to the inode — survives renames of original.","updatedAt":"2026-03-03T04:02:30.722Z"},{"_id":"69a65d56ff996647cc9a6c5c","command":"stat","category":"File System","description":"Display detailed file metadata (inode, permissions, timestamps).","examples":["stat /etc/passwd","stat -c \"%n: %s bytes, %y\" *.log"],"flags":[{"flag":"-c \"%n %s\"","meaning":"Custom format: name and size"},{"flag":"-f","meaning":"Filesystem stats instead of file"},{"flag":"--printf=\"%A\\n\"","meaning":"Print symbolic permissions"}],"synopsis":"stat [OPTIONS] FILE","tip":"stat shows atime (access), mtime (modify), ctime (change metadata).","updatedAt":"2026-03-03T04:02:30.765Z"},{"_id":"69a65d56ff996647cc9a6c5d","command":"du","category":"File System","description":"Estimate disk usage of files and directories.","examples":["du -sh /*","du -h --max-depth=1 ~ | sort -hr","du -sh ~/Downloads/*"],"flags":[{"flag":"-h","meaning":"Human-readable (K, M, G)"},{"flag":"-s","meaning":"Summary only (total)"},{"flag":"-c","meaning":"Grand total"},{"flag":"--max-depth=N","meaning":"Limit depth"},{"flag":"--exclude=PATTERN","meaning":"Skip matching paths"}],"synopsis":"du [OPTIONS] [PATH]","tip":"du -sh * | sort -hr lists all items sorted by size.","updatedAt":"2026-03-03T04:02:30.812Z"},{"_id":"69a65d56ff996647cc9a6c5e","command":"df","category":"System Info","description":"Report disk space usage of filesystems.","examples":["df -hT","df -h /home","df -i  # check inode exhaustion"],"flags":[{"flag":"-h","meaning":"Human-readable sizes"},{"flag":"-T","meaning":"Show filesystem type"},{"flag":"-i","meaning":"Show inode usage instead of block usage"},{"flag":"-x tmpfs","meaning":"Exclude tmpfs mounts"}],"synopsis":"df [OPTIONS] [FILESYSTEM]","tip":"If \"no space left\" but df -h shows space, check inodes with df -i.","updatedAt":"2026-03-03T04:02:30.855Z"},{"_id":"69a65d56ff996647cc9a6c5f","command":"grep","category":"Text Processing","description":"Search text using patterns. Global Regular Expression Print.","examples":["grep -rn \"TODO\" . --include=\"*.py\"","grep -v \"^#\" /etc/ssh/sshd_config | grep -v \"^$\"","ps aux | grep -v grep | grep nginx"],"flags":[{"flag":"-i","meaning":"Case-insensitive"},{"flag":"-r","meaning":"Recursive search in directories"},{"flag":"-n","meaning":"Show line numbers"},{"flag":"-v","meaning":"Invert match (lines NOT matching)"},{"flag":"-l","meaning":"Only print filenames"},{"flag":"-c","meaning":"Count matches per file"},{"flag":"-A N","meaning":"N lines After match"},{"flag":"-B N","meaning":"N lines Before match"},{"flag":"-E","meaning":"Extended regex (ERE)"},{"flag":"-P","meaning":"Perl regex (PCRE)"},{"flag":"-w","meaning":"Match whole words only"},{"flag":"--include=\"*.py\"","meaning":"Only search matching filenames"}],"synopsis":"grep [OPTIONS] PATTERN [FILE]","tip":"rg (ripgrep) is grep but 10-100x faster. Always prefer rg for codebases.","updatedAt":"2026-03-03T04:02:30.901Z"},{"_id":"69a65d56ff996647cc9a6c60","command":"sed","category":"Text Processing","description":"Stream editor. Non-interactive find/replace and line manipulation.","examples":["sed -i.bak 's/foo/bar/g' file.txt","sed -n '10,20p' file.txt  # print lines 10-20","sed '/^#/d' config.conf    # delete comment lines","sed 's/^/  /' file.txt    # indent each line"],"flags":[{"flag":"-i","meaning":"Edit file in-place"},{"flag":"-i.bak","meaning":"In-place with backup"},{"flag":"-n","meaning":"Suppress auto-print"},{"flag":"-e","meaning":"Multiple expressions"},{"flag":"-E","meaning":"Extended regex"}],"synopsis":"sed [OPTIONS] SCRIPT [FILE]","tip":"s/old/new/g: substitute. d: delete. p: print. q: quit at line N.","updatedAt":"2026-03-03T04:02:30.953Z"},{"_id":"69a65d56ff996647cc9a6c61","command":"awk","category":"Text Processing","description":"Pattern-action language for column-based text processing.","examples":["awk '{print $1, $3}' log.txt","awk -F: '{print $1}' /etc/passwd","awk '{sum+=$1} END{print sum}' numbers.txt","awk 'NR%2==0' file  # print even lines","df -h | awk 'NR>1 {print $5, $6}'"],"flags":[{"flag":"-F,","meaning":"Set field separator to comma"},{"flag":"-v VAR=val","meaning":"Set a variable"},{"flag":"-f FILE","meaning":"Read program from file"}],"synopsis":"awk [OPTIONS] PROGRAM [FILE]","tip":"$0=whole line, $1=first field, NF=num fields, NR=line number, FS=separator.","updatedAt":"2026-03-03T04:02:31.001Z"},{"_id":"69a65d57ff996647cc9a6c62","command":"sort","category":"Text Processing","description":"Sort lines of text.","examples":["sort -t: -k3 -n /etc/passwd","du -sh * | sort -rh","sort -u names.txt"],"flags":[{"flag":"-n","meaning":"Numeric sort"},{"flag":"-r","meaning":"Reverse order"},{"flag":"-k2","meaning":"Sort by field 2"},{"flag":"-t,","meaning":"Field separator is comma"},{"flag":"-u","meaning":"Unique (remove duplicates)"},{"flag":"-h","meaning":"Human-numeric sort (2K < 1M)"},{"flag":"-R","meaning":"Random shuffle"}],"synopsis":"sort [OPTIONS] [FILE]","tip":"sort | uniq -c | sort -rn gives a frequency count of lines, most common first.","updatedAt":"2026-03-03T04:02:31.083Z"},{"_id":"69a65d57ff996647cc9a6c63","command":"uniq","category":"Text Processing","description":"Report or omit repeated adjacent lines. Input must be sorted.","examples":["sort file | uniq -c | sort -rn","cat access.log | awk \"{print $1}\" | sort | uniq -c | sort -rn"],"flags":[{"flag":"-c","meaning":"Prefix count of occurrences"},{"flag":"-d","meaning":"Only print duplicate lines"},{"flag":"-u","meaning":"Only print unique lines"},{"flag":"-i","meaning":"Case-insensitive comparison"}],"synopsis":"uniq [OPTIONS] [FILE]","tip":"Always pipe through sort first — uniq only deduplicates consecutive lines.","updatedAt":"2026-03-03T04:02:31.136Z"},{"_id":"69a65d57ff996647cc9a6c64","command":"cut","category":"Text Processing","description":"Remove sections from each line (by byte, character, or field).","examples":["cut -d: -f1,3 /etc/passwd","cut -c1-80 longlines.txt","echo 'a:b:c' | cut -d: -f2"],"flags":[{"flag":"-d,","meaning":"Delimiter is comma"},{"flag":"-f1,3","meaning":"Extract fields 1 and 3"},{"flag":"-c1-10","meaning":"Extract characters 1 to 10"},{"flag":"--complement","meaning":"Invert selection"}],"synopsis":"cut [OPTIONS] [FILE]","tip":"For complex field extraction, awk -F is more flexible than cut.","updatedAt":"2026-03-03T04:02:31.182Z"},{"_id":"69a65d57ff996647cc9a6c65","command":"jq","category":"Text Processing","description":"Command-line JSON processor and query language.","examples":["curl api.example.com | jq .","jq \".[] | select(.status==\\\"active\\\") | .name\" data.json","cat log.json | jq -r \".items[].id\"","jq -n --arg name \"$USER\" \"{user: $name}\""],"flags":[{"flag":"-r","meaning":"Raw output (no quotes)"},{"flag":"-c","meaning":"Compact output"},{"flag":"-e","meaning":"Exit 1 if output is false/null"},{"flag":"--arg k v","meaning":"Pass shell variable as string"},{"flag":"-s","meaning":"Slurp: read all input into array"}],"synopsis":"jq [OPTIONS] FILTER [FILE]","tip":"jq \".\" pretty-prints. jq \".key\" extracts. jq \".[]\" iterates arrays.","updatedAt":"2026-03-03T04:02:31.222Z"},{"_id":"69a65d57ff996647cc9a6c66","command":"xargs","category":"Text Processing","description":"Build and execute command lines from stdin. Bridges pipes to commands that only accept arguments.","examples":["find . -name \"*.log\" -print0 | xargs -0 rm","cat urls.txt | xargs -P 4 -I{} curl -O {}","echo \"a b c\" | xargs -n1 echo"],"flags":[{"flag":"-I{}","meaning":"Replace {} with input item"},{"flag":"-n1","meaning":"One argument per command invocation"},{"flag":"-P4","meaning":"Run 4 processes in parallel"},{"flag":"-0","meaning":"Input delimited by null (use with find -print0)"},{"flag":"-t","meaning":"Print command before running"}],"synopsis":"xargs [OPTIONS] COMMAND","tip":"Use -0 with find -print0 to handle filenames with spaces safely.","updatedAt":"2026-03-03T04:02:31.275Z"},{"_id":"69a65d57ff996647cc9a6c67","command":"tee","category":"Text Processing","description":"Read stdin and write to both stdout and a file simultaneously.","examples":["make 2>&1 | tee build.log","curl api.example.com | tee response.json | jq .","sudo tee /etc/hosts <<< \"127.0.0.1 myapp\""],"flags":[{"flag":"-a","meaning":"Append to file instead of overwrite"}],"synopsis":"tee [OPTIONS] FILE","tip":"tee lets you pipe AND save. Use 2>&1 before tee to capture stderr too.","updatedAt":"2026-03-03T04:02:31.318Z"},{"_id":"69a65d57ff996647cc9a6c68","command":"wc","category":"Text Processing","description":"Count lines, words, and characters.","examples":["wc -l *.py","cat file | wc -l","find . -name \"*.rs\" | wc -l"],"flags":[{"flag":"-l","meaning":"Line count"},{"flag":"-w","meaning":"Word count"},{"flag":"-c","meaning":"Byte count"},{"flag":"-m","meaning":"Character count"}],"synopsis":"wc [OPTIONS] [FILE]","tip":"wc -l is the fastest way to count lines. Use find | wc -l to count files.","updatedAt":"2026-03-03T04:02:31.360Z"},{"_id":"69a65d57ff996647cc9a6c69","command":"diff","category":"Text Processing","description":"Compare files line by line.","examples":["diff -u old.conf new.conf","diff -rq dir1/ dir2/","diff <(sort file1) <(sort file2)"],"flags":[{"flag":"-u","meaning":"Unified diff (most common, used by git)"},{"flag":"-r","meaning":"Recursive compare directories"},{"flag":"-i","meaning":"Ignore case differences"},{"flag":"-w","meaning":"Ignore all whitespace"},{"flag":"--color","meaning":"Colored output"}],"synopsis":"diff [OPTIONS] FILE1 FILE2","tip":"diff <(cmd1) <(cmd2) uses process substitution to diff command outputs.","updatedAt":"2026-03-03T04:02:31.404Z"},{"_id":"69a65d57ff996647cc9a6c6a","command":"ps","category":"Process Management","description":"Report a snapshot of current processes.","examples":["ps aux | grep nginx","ps -ef --forest  # show process tree","ps -o pid,ppid,cmd,%cpu,%mem --sort=-%cpu | head -20"],"flags":[{"flag":"aux","meaning":"All processes with user (BSD style)"},{"flag":"-ef","meaning":"All processes, full format (SysV style)"},{"flag":"-p PID","meaning":"Show specific PID"},{"flag":"--sort=-%cpu","meaning":"Sort by CPU descending"},{"flag":"-o pid,comm,%cpu,%mem","meaning":"Custom output columns"}],"synopsis":"ps [OPTIONS]","tip":"ps aux vs ps -ef differ slightly in output. Both show all processes.","updatedAt":"2026-03-03T04:02:31.448Z"},{"_id":"69a65d57ff996647cc9a6c6b","command":"top","category":"Process Management","description":"Interactive real-time process viewer.","examples":["top -d 1","top -b -n 1 | head -20  # scriptable snapshot","top -p $(pgrep nginx | tr \"\\n\" \",\")"],"flags":[{"flag":"-d 2","meaning":"Refresh every 2 seconds"},{"flag":"-p PID","meaning":"Watch specific process"},{"flag":"-u USER","meaning":"Filter by user"},{"flag":"-b -n1","meaning":"Batch mode, one snapshot (for scripts)"}],"synopsis":"top","tip":"In top: M=sort by mem, P=sort by cpu, k=kill, r=renice, q=quit, 1=per-core CPU.","updatedAt":"2026-03-03T04:02:31.491Z"},{"_id":"69a65d57ff996647cc9a6c6c","command":"kill","category":"Process Management","description":"Send a signal to a process.","examples":["kill -9 1234","kill -HUP $(cat /var/run/nginx.pid)","pkill -f myprocess  # kill by name","killall -9 python3"],"flags":[{"flag":"-9 / SIGKILL","meaning":"Force kill (cannot be caught or ignored)"},{"flag":"-15 / SIGTERM","meaning":"Graceful shutdown (default)"},{"flag":"-1 / SIGHUP","meaning":"Reload config (many daemons)"},{"flag":"-l","meaning":"List all signal names"},{"flag":"-s SIGNAL","meaning":"Send named signal"}],"synopsis":"kill [SIGNAL] PID","tip":"SIGTERM (15) first — gives the process a chance to clean up. SIGKILL (9) is last resort.","updatedAt":"2026-03-03T04:02:31.529Z"},{"_id":"69a65d57ff996647cc9a6c6d","command":"lsof","category":"Process Management","description":"List open files — shows which process has which file/socket open.","examples":["lsof -i :3000","lsof -i tcp -n -P | grep LISTEN","lsof -p 1234 | grep REG","lsof +D /var/log"],"flags":[{"flag":"-i :8080","meaning":"Processes listening on port 8080"},{"flag":"-p PID","meaning":"Files opened by PID"},{"flag":"-u USER","meaning":"Files opened by user"},{"flag":"-c nginx","meaning":"Files opened by matching command name"},{"flag":"+D /path","meaning":"All files open under directory"}],"synopsis":"lsof [OPTIONS]","tip":"\"Who is using port 80?\" → lsof -i :80. Pairs well with kill after finding the PID.","updatedAt":"2026-03-03T04:02:31.573Z"},{"_id":"69a65d57ff996647cc9a6c6e","command":"strace","category":"Process Management","description":"Trace system calls and signals made by a process. Essential for debugging.","examples":["strace -e trace=network curl google.com","strace -c ./myprogram","strace -p 1234 -o /tmp/strace.log"],"flags":[{"flag":"-p PID","meaning":"Attach to running process"},{"flag":"-e trace=open,read","meaning":"Filter to specific syscalls"},{"flag":"-c","meaning":"Count syscall frequency and time"},{"flag":"-o file","meaning":"Write output to file"},{"flag":"-f","meaning":"Follow child processes"},{"flag":"-T","meaning":"Show time spent per syscall"}],"synopsis":"strace [OPTIONS] COMMAND","tip":"\"Why is my program hanging?\" → strace -p PID to see which syscall it is stuck on.","updatedAt":"2026-03-03T04:02:31.618Z"},{"_id":"69a65d57ff996647cc9a6c6f","command":"watch","category":"Process Management","description":"Execute a command repeatedly and display output. Default every 2s.","examples":["watch -n 1 \"ps aux | grep myapp\"","watch -d df -h","watch -n 0.5 \"cat /proc/loadavg\""],"flags":[{"flag":"-n 1","meaning":"Refresh every 1 second"},{"flag":"-d","meaning":"Highlight differences between outputs"},{"flag":"-t","meaning":"Turn off header (title line)"},{"flag":"-e","meaning":"Exit on non-zero command exit code"}],"synopsis":"watch [OPTIONS] COMMAND","tip":"watch -d highlights what changed since last run — great for monitoring state changes.","updatedAt":"2026-03-03T04:02:31.662Z"},{"_id":"69a65d57ff996647cc9a6c70","command":"nohup","category":"Process Management","description":"Run a command immune to hangups (SIGHUP). Survives terminal close.","examples":["nohup python3 server.py > server.log 2>&1 &","nohup ./long_job.sh &  # output goes to nohup.out"],"flags":[],"synopsis":"nohup COMMAND &","tip":"Combine with & to background. Use jobs to list, fg %1 to bring back.","updatedAt":"2026-03-03T04:02:31.713Z"},{"_id":"69a65d57ff996647cc9a6c71","command":"time","category":"Process Management","description":"Measure command execution time. Reports real, user, and sys time.","examples":["time python3 sort.py","time make -j8","\\time -v ./myprogram  # verbose: peak RSS, page faults"],"flags":[],"synopsis":"time COMMAND","tip":"real=wall clock, user=CPU in user space, sys=CPU in kernel. user+sys < real means I/O-bound.","updatedAt":"2026-03-03T04:02:31.760Z"},{"_id":"69a65d57ff996647cc9a6c72","command":"curl","category":"Networking","description":"Transfer data from/to servers. Supports HTTP, HTTPS, FTP, and more.","examples":["curl -X POST -H 'Content-Type: application/json' -d '{\"key\":\"val\"}' https://api.example.com/endpoint","curl -sL https://example.com | grep title","curl -o /dev/null -s -w '%{http_code}' https://example.com"],"flags":[{"flag":"-X POST","meaning":"HTTP method"},{"flag":"-H \"Header: val\"","meaning":"Set request header"},{"flag":"-d \"data\"","meaning":"Request body (POST)"},{"flag":"-o file","meaning":"Save to file"},{"flag":"-O","meaning":"Save with remote filename"},{"flag":"-L","meaning":"Follow redirects"},{"flag":"-s","meaning":"Silent (no progress)"},{"flag":"-v","meaning":"Verbose (show request/response headers)"},{"flag":"-k","meaning":"Skip TLS cert verification"},{"flag":"-u user:pass","meaning":"Basic auth"},{"flag":"--retry 3","meaning":"Retry on failure"}],"synopsis":"curl [OPTIONS] URL","tip":"curl -w \"%{time_total}\" times a request. curl -I does HEAD only.","updatedAt":"2026-03-03T04:02:31.805Z"},{"_id":"69a65d57ff996647cc9a6c73","command":"ssh","category":"Networking","description":"Secure Shell — remote login and command execution.","examples":["ssh -L 5432:db-host:5432 bastion-host  # tunnel postgres","ssh -N -D 1080 jump-host  # SOCKS proxy","ssh -A ubuntu@bastion  # agent forwarding"],"flags":[{"flag":"-i ~/.ssh/key","meaning":"Identity file (private key)"},{"flag":"-p 2222","meaning":"Custom port"},{"flag":"-L 8080:localhost:80","meaning":"Local port forward"},{"flag":"-R 8080:localhost:80","meaning":"Remote port forward"},{"flag":"-N","meaning":"No command, just tunnel"},{"flag":"-D 1080","meaning":"SOCKS proxy"},{"flag":"-A","meaning":"Forward SSH agent"},{"flag":"-v","meaning":"Verbose debug output"},{"flag":"-o StrictHostKeyChecking=no","meaning":"Skip host key check"}],"synopsis":"ssh [OPTIONS] USER@HOST","tip":"Put common options in ~/.ssh/config: Host, User, IdentityFile, ProxyJump, etc.","updatedAt":"2026-03-03T04:02:31.850Z"},{"_id":"69a65d57ff996647cc9a6c74","command":"rsync","category":"Networking","description":"Fast incremental file transfer. Only copies changed parts.","examples":["rsync -avzP ./dist/ user@server:/var/www/","rsync -avn --delete src/ dst/  # dry run first","rsync -a --exclude=\"node_modules\" . remote:~/project/"],"flags":[{"flag":"-a","meaning":"Archive: recursive + preserve perms/times/links"},{"flag":"-v","meaning":"Verbose"},{"flag":"-z","meaning":"Compress during transfer"},{"flag":"-P","meaning":"Show progress + keep partial"},{"flag":"-n / --dry-run","meaning":"Show what would be done"},{"flag":"--delete","meaning":"Remove dest files not in src"},{"flag":"--exclude=\"*.pyc\"","meaning":"Exclude pattern"},{"flag":"-e \"ssh -p 2222\"","meaning":"Use custom SSH command"}],"synopsis":"rsync [OPTIONS] SRC DEST","tip":"rsync trailing slash on src matters: src/ copies contents, src copies the dir itself.","updatedAt":"2026-03-03T04:02:31.892Z"},{"_id":"69a65d57ff996647cc9a6c75","command":"scp","category":"Networking","description":"Secure copy over SSH.","examples":["scp -r ./deploy user@server:~/app/","scp user@server:~/logs/app.log ."],"flags":[{"flag":"-r","meaning":"Recursive (directories)"},{"flag":"-P 2222","meaning":"Custom port (capital P, unlike ssh)"},{"flag":"-i key","meaning":"Identity file"},{"flag":"-C","meaning":"Compress"}],"synopsis":"scp [OPTIONS] SRC DEST","tip":"For large transfers, rsync -avzP is better — it resumes if interrupted.","updatedAt":"2026-03-03T04:02:31.936Z"},{"_id":"69a65d57ff996647cc9a6c76","command":"ss","category":"Networking","description":"Socket statistics. Modern replacement for netstat.","examples":["ss -tlnp  # listening TCP with PIDs","ss -s  # summary statistics","ss -tnp state established"],"flags":[{"flag":"-t","meaning":"TCP sockets"},{"flag":"-u","meaning":"UDP sockets"},{"flag":"-l","meaning":"Listening ports only"},{"flag":"-n","meaning":"Do not resolve names"},{"flag":"-p","meaning":"Show process name/PID"},{"flag":"-a","meaning":"All sockets"},{"flag":"-4 / -6","meaning":"IPv4 / IPv6 only"}],"synopsis":"ss [OPTIONS]","tip":"\"Who is listening on port 443?\" → ss -tlnp | grep :443","updatedAt":"2026-03-03T04:02:31.980Z"},{"_id":"69a65d58ff996647cc9a6c77","command":"netcat (nc)","category":"Networking","description":"Netcat — the Swiss Army knife of networking. Raw TCP/UDP connections.","examples":["nc -zv host.com 22 443  # port scan","nc -l 4444  # simple listener","cat file | nc host 9999  # send a file","nc -l 9999 > received_file"],"flags":[{"flag":"-l","meaning":"Listen mode"},{"flag":"-p PORT","meaning":"Local port to listen on"},{"flag":"-u","meaning":"UDP mode"},{"flag":"-v","meaning":"Verbose"},{"flag":"-z","meaning":"Scan mode (no data sent)"},{"flag":"-w N","meaning":"Timeout after N seconds"},{"flag":"-e CMD","meaning":"Execute command on connect"}],"synopsis":"nc [OPTIONS] HOST PORT","tip":"Use nc for quick port checks, file transfers, and debugging network connections.","updatedAt":"2026-03-03T04:02:32.029Z"},{"_id":"69a65d58ff996647cc9a6c78","command":"dig","category":"Networking","description":"DNS lookup utility. More detailed than nslookup.","examples":["dig +short google.com A","dig @1.1.1.1 github.com","dig -x 8.8.8.8","dig +trace example.com"],"flags":[{"flag":"+short","meaning":"Short answer only"},{"flag":"+trace","meaning":"Trace delegation from root"},{"flag":"@8.8.8.8","meaning":"Use specific DNS server"},{"flag":"-x IP","meaning":"Reverse lookup (PTR)"},{"flag":"MX","meaning":"Query MX records"},{"flag":"ANY","meaning":"All record types"}],"synopsis":"dig [OPTIONS] NAME [TYPE]","tip":"dig +short is the fastest way to just get the IP. Use +trace to debug DNS propagation.","updatedAt":"2026-03-03T04:02:32.070Z"},{"_id":"69a65d58ff996647cc9a6c79","command":"tcpdump","category":"Networking","description":"Capture and analyze network packets.","examples":["tcpdump -i any -n port 80","tcpdump -i eth0 -w capture.pcap host 10.0.0.1","tcpdump -r capture.pcap | grep \"HTTP\""],"flags":[{"flag":"-i eth0","meaning":"Interface to capture on"},{"flag":"-n","meaning":"Do not resolve names"},{"flag":"-v / -vv","meaning":"Verbose packet info"},{"flag":"-w file.pcap","meaning":"Save to pcap file"},{"flag":"-r file.pcap","meaning":"Read from pcap file"},{"flag":"port 80","meaning":"Filter by port"},{"flag":"host 1.2.3.4","meaning":"Filter by host"},{"flag":"-c 100","meaning":"Capture 100 packets then stop"}],"synopsis":"tcpdump [OPTIONS] [FILTER]","tip":"tcpdump -i any captures all interfaces. Save with -w, analyze in Wireshark.","updatedAt":"2026-03-03T04:02:32.121Z"},{"_id":"69a65d58ff996647cc9a6c7a","command":"ping","category":"Networking","description":"Send ICMP ECHO_REQUEST to measure Round Trip Time and packet loss.","examples":["ping -c 4 8.8.8.8","ping -c 100 -i 0.1 host | tail -2  # measure packet loss"],"flags":[{"flag":"-c N","meaning":"Send N packets then stop"},{"flag":"-i 0.2","meaning":"Interval between packets (seconds)"},{"flag":"-s 1024","meaning":"Packet size in bytes"},{"flag":"-t 64","meaning":"TTL"},{"flag":"-4 / -6","meaning":"Force IPv4 / IPv6"}],"synopsis":"ping [OPTIONS] HOST","tip":"If ping works but curl fails — DNS or application issue. If ping fails — routing/firewall.","updatedAt":"2026-03-03T04:02:32.163Z"},{"_id":"69a65d58ff996647cc9a6c7b","command":"uname","category":"System Info","description":"Print system information (kernel, architecture, hostname).","examples":["uname -a","uname -r  # kernel version","uname -m  # architecture"],"flags":[{"flag":"-a","meaning":"All information"},{"flag":"-r","meaning":"Kernel release"},{"flag":"-m","meaning":"Machine hardware (x86_64, aarch64)"},{"flag":"-s","meaning":"Kernel name"},{"flag":"-n","meaning":"Network node hostname"}],"synopsis":"uname [OPTIONS]","tip":"uname -m tells you if you are on x86_64 or arm64 — critical for binaries/containers.","updatedAt":"2026-03-03T04:02:32.204Z"},{"_id":"69a65d58ff996647cc9a6c7c","command":"free","category":"System Info","description":"Display amount of free and used memory.","examples":["free -h","watch -n 1 free -h"],"flags":[{"flag":"-h","meaning":"Human-readable"},{"flag":"-m","meaning":"Output in megabytes"},{"flag":"-s N","meaning":"Update every N seconds"},{"flag":"-t","meaning":"Show totals row"}],"synopsis":"free [OPTIONS]","tip":"\"available\" is the realistic free memory — includes reclaimable cache. \"free\" is just truly unused.","updatedAt":"2026-03-03T04:02:32.250Z"},{"_id":"69a65d58ff996647cc9a6c7d","command":"lscpu","category":"System Info","description":"Display CPU architecture information (cores, threads, NUMA, cache).","examples":["lscpu","lscpu | grep -E \"^CPU\\(s\\)|Thread|Socket|NUMA\""],"flags":[{"flag":"-e","meaning":"Extended format, one line per CPU"},{"flag":"-J","meaning":"JSON output"},{"flag":"-p","meaning":"Parseable format"}],"synopsis":"lscpu","tip":"lscpu shows logical CPUs. Thermal throttling shows up in /proc/cpuinfo (MHz drops).","updatedAt":"2026-03-03T04:02:32.295Z"},{"_id":"69a65d58ff996647cc9a6c7e","command":"dmesg","category":"System Info","description":"Print kernel ring buffer — hardware events, driver messages, OOM kills.","examples":["dmesg -T | tail -50","dmesg -l err,warn | tail -30","dmesg -T | grep -i \"oom\"  # OOM killer events"],"flags":[{"flag":"-H","meaning":"Human-readable with timestamps"},{"flag":"-T","meaning":"Readable timestamps"},{"flag":"-l err,warn","meaning":"Filter by severity level"},{"flag":"-f daemon","meaning":"Filter by facility"},{"flag":"-w","meaning":"Watch (follow) new messages"},{"flag":"--since \"1 hour ago\"","meaning":"Recent messages only"}],"synopsis":"dmesg [OPTIONS]","tip":"dmesg is the first place to look after kernel panics, disk errors, or hardware failures.","updatedAt":"2026-03-03T04:02:32.339Z"},{"_id":"69a65d58ff996647cc9a6c7f","command":"journalctl","category":"System Info","description":"Query the systemd journal (structured logging for all services).","examples":["journalctl -u nginx -f","journalctl --since \"2026-03-01\" -p err","journalctl -b -1  # previous boot logs"],"flags":[{"flag":"-u nginx","meaning":"Logs for a specific unit"},{"flag":"-f","meaning":"Follow (tail) new messages"},{"flag":"-n 100","meaning":"Show last 100 lines"},{"flag":"--since \"1h ago\"","meaning":"Time filter"},{"flag":"-p err","meaning":"Priority filter (emerg, alert, crit, err, warning, notice, info, debug)"},{"flag":"-b","meaning":"Current boot only"},{"flag":"-o json","meaning":"JSON output"},{"flag":"-k","meaning":"Kernel messages only"}],"synopsis":"journalctl [OPTIONS]","tip":"journalctl -xeu servicename gives detailed explanation of service failures.","updatedAt":"2026-03-03T04:02:32.390Z"},{"_id":"69a65d58ff996647cc9a6c80","command":"lsblk","category":"System Info","description":"List block devices (disks, partitions, LVM, RAID) in tree view.","examples":["lsblk -f","lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT"],"flags":[{"flag":"-f","meaning":"Show filesystem type and UUID"},{"flag":"-d","meaning":"No children (disks only)"},{"flag":"-o NAME,SIZE,TYPE,MOUNTPOINT","meaning":"Custom columns"},{"flag":"-J","meaning":"JSON output"}],"synopsis":"lsblk [OPTIONS]","tip":"lsblk + df -h together give a full picture of disk layout and usage.","updatedAt":"2026-03-03T04:02:32.434Z"},{"_id":"69a65d58ff996647cc9a6c81","command":"chmod","category":"Permissions","description":"Change file permissions. Use octal or symbolic notation.","examples":["chmod +x script.sh","chmod -R 644 ./public/","chmod 600 ~/.ssh/id_rsa"],"flags":[{"flag":"-R","meaning":"Recursive"},{"flag":"-v","meaning":"Verbose"},{"flag":"u+x","meaning":"Add execute for user"},{"flag":"go-w","meaning":"Remove write for group and others"},{"flag":"755","meaning":"rwxr-xr-x (common for executables)"},{"flag":"644","meaning":"rw-r--r-- (common for files)"},{"flag":"700","meaning":"rwx------ (private dir)"}],"synopsis":"chmod [OPTIONS] MODE FILE","tip":"chmod 600 for private keys is required — SSH refuses to use keys that are too permissive.","updatedAt":"2026-03-03T04:02:32.483Z"},{"_id":"69a65d58ff996647cc9a6c82","command":"chown","category":"Permissions","description":"Change file owner and group.","examples":["chown www-data:www-data /var/www/","chown -R $USER:$USER ~/projects/","chown root:root /etc/sudoers && chmod 440 /etc/sudoers"],"flags":[{"flag":"-R","meaning":"Recursive"},{"flag":"-v","meaning":"Verbose"},{"flag":"--from=USER","meaning":"Only change if current owner matches"}],"synopsis":"chown [OPTIONS] USER[:GROUP] FILE","tip":"chown user:group changes both. chown user: uses the user's default group.","updatedAt":"2026-03-03T04:02:32.528Z"},{"_id":"69a65d58ff996647cc9a6c83","command":"sudo","category":"Permissions","description":"Execute a command as another user (usually root).","examples":["sudo systemctl restart nginx","sudo -u postgres psql","sudo -i  # root shell","sudo -l  # what can I run?"],"flags":[{"flag":"-u USER","meaning":"Run as USER instead of root"},{"flag":"-i","meaning":"Login shell as root"},{"flag":"-s","meaning":"Shell as root"},{"flag":"-l","meaning":"List permitted commands"},{"flag":"-k","meaning":"Invalidate cached credentials"},{"flag":"-E","meaning":"Preserve calling user's environment"}],"synopsis":"sudo [OPTIONS] COMMAND","tip":"sudo !! reruns the last command with sudo (bash). Avoid sudo su — use sudo -i instead.","updatedAt":"2026-03-03T04:02:32.571Z"},{"_id":"69a65d58ff996647cc9a6c84","command":"umask","category":"Permissions","description":"Set default permission mask for new files. Default 022 means files get 644, dirs get 755.","examples":["umask","umask -S","umask 027  # files get 640, dirs get 750 (more private)"],"flags":[{"flag":"-S","meaning":"Show symbolic representation"}],"synopsis":"umask [MODE]","tip":"umask 022: subtract from 777(dirs) or 666(files). 022 → dirs 755, files 644.","updatedAt":"2026-03-03T04:02:32.613Z"},{"_id":"69a65d58ff996647cc9a6c85","command":"tar","category":"Archives","description":"Tape archive — pack/unpack files. Commonly combined with gzip or xz.","examples":["tar -czvf archive.tar.gz dir/","tar -xzvf archive.tar.gz -C /opt/","tar -tvf archive.tar.gz | head","tar -cJvf archive.tar.xz --exclude=\"*.pyc\" project/"],"flags":[{"flag":"-c","meaning":"Create archive"},{"flag":"-x","meaning":"Extract archive"},{"flag":"-v","meaning":"Verbose"},{"flag":"-f FILE","meaning":"Specify archive filename"},{"flag":"-z","meaning":"Gzip compression (.tar.gz / .tgz)"},{"flag":"-j","meaning":"Bzip2 compression (.tar.bz2)"},{"flag":"-J","meaning":"XZ compression (.tar.xz) — best compression"},{"flag":"-C DIR","meaning":"Change to DIR before extracting"},{"flag":"--exclude=PATTERN","meaning":"Exclude files matching pattern"},{"flag":"-t","meaning":"List contents without extracting"}],"synopsis":"tar [OPTIONS] [FILE]","tip":"Mnemonic: \"Create Ze Files\" (-czf) and \"eXtract Ze Files\" (-xzf).","updatedAt":"2026-03-03T04:02:32.657Z"},{"_id":"69a65d58ff996647cc9a6c86","command":"gzip/gunzip","category":"Archives","description":"Compress or decompress files using DEFLATE (Lempel-Ziv + Huffman).","examples":["gzip -k largefile.log","gzip -d file.gz","zcat file.gz | head -20  # view without extracting"],"flags":[{"flag":"-k","meaning":"Keep original file"},{"flag":"-d","meaning":"Decompress (same as gunzip)"},{"flag":"-9","meaning":"Maximum compression (slowest)"},{"flag":"-1","meaning":"Fastest compression"},{"flag":"-l","meaning":"List compressed file info"},{"flag":"-r","meaning":"Recursive (directory)"}],"synopsis":"gzip [OPTIONS] FILE","tip":"zcat, zgrep, zless work on .gz files without decompressing first — saves disk I/O.","updatedAt":"2026-03-03T04:02:32.702Z"},{"_id":"69a65d58ff996647cc9a6c87","command":"tmux","category":"Shell / Terminal","description":"Terminal multiplexer — persistent sessions, splits, and windows. Prefix: Ctrl-b","examples":["tmux new -s dev","tmux attach -t dev","tmux ls"],"flags":[{"flag":"new -s NAME","meaning":"Create named session"},{"flag":"ls","meaning":"List sessions"},{"flag":"attach -t NAME","meaning":"Attach to session"},{"flag":"kill-session -t NAME","meaning":"Kill session"}],"synopsis":"tmux [COMMAND]","tip":"Key bindings — prefix then: % (vsplit), \" (hsplit), d (detach), [ (scroll), z (zoom pane), & (kill window), c (new window), n/p (next/prev window).","updatedAt":"2026-03-03T04:02:32.748Z"},{"_id":"69a65d58ff996647cc9a6c88","command":"fzf","category":"Shell / Terminal","description":"Fuzzy finder for any list. Integrates with shell history, git, files.","examples":["vim $(fzf)","kill $(ps aux | fzf | awk \"{print $2}\")","git log --oneline | fzf --preview \"git show {1}\""],"flags":[{"flag":"--preview \"cat {}\"","meaning":"Show preview on the right"},{"flag":"--multi / -m","meaning":"Select multiple items"},{"flag":"--height 40%","meaning":"Inline mode"},{"flag":"--bind \"ctrl-y:execute(echo {}|pbcopy)\"","meaning":"Custom keybind"},{"flag":"-q QUERY","meaning":"Initial query"}],"synopsis":"fzf [OPTIONS]","tip":"Add to .bashrc: Ctrl-R=history via fzf (export FZF_DEFAULT_OPTS), Alt-C=cd via fzf.","updatedAt":"2026-03-03T04:02:32.798Z"},{"_id":"69a65d58ff996647cc9a6c89","command":"history","category":"Shell / Terminal","description":"Display command history. Used with !! and !N shortcuts.","examples":["history | grep ssh","!123  # run command 123","!!  # repeat last command","!ssh  # repeat last command starting with ssh","history | tail"],"flags":[{"flag":"-c","meaning":"Clear history"},{"flag":"-w","meaning":"Write to file immediately"},{"flag":"-d N","meaning":"Delete entry N"}],"synopsis":"history [N]","tip":"HISTIGNORE=\"ls:cd:pwd:exit\" skips trivial commands. HISTSIZE=10000 for longer history.","updatedAt":"2026-03-03T04:02:32.845Z"},{"_id":"69a65d58ff996647cc9a6c8a","command":"env / export","category":"Shell / Terminal","description":"View or set environment variables. export makes them available to child processes.","examples":["env | sort","export PATH=\"$HOME/.local/bin:$PATH\"","env -i HOME=\"$HOME\" bash  # clean environment","printenv PYTHONPATH"],"flags":[{"flag":"-i","meaning":"Start with empty environment"},{"flag":"-u VAR","meaning":"Unset variable"}],"synopsis":"env OR export VAR=val","tip":"\"export\" persists to child processes. \"VAR=val command\" sets it only for that command.","updatedAt":"2026-03-03T04:02:32.885Z"},{"_id":"69a65d58ff996647cc9a6c8b","command":"redirect & pipes","category":"Shell / Terminal","description":"Shell I/O redirection and piping operators.","examples":["command > out.log 2>&1 &","cmd1 | cmd2 | cmd3","grep \"err\" app.log 2>/dev/null","cat <<EOF > config.toml\nkey = \"val\"\nEOF"],"flags":[{"flag":">","meaning":"Redirect stdout (overwrite)"},{"flag":">>","meaning":"Redirect stdout (append)"},{"flag":"2>","meaning":"Redirect stderr"},{"flag":"2>&1","meaning":"Merge stderr into stdout"},{"flag":"|","meaning":"Pipe stdout of cmd1 to stdin of cmd2"},{"flag":"&","meaning":"Run in background"},{"flag":"/dev/null","meaning":"Discard output"},{"flag":"<<<","meaning":"Here-string: pass string as stdin"},{"flag":"<<EOF","meaning":"Heredoc: multiline string as stdin"}],"synopsis":"> >> 2> | &","tip":"2>&1 must come AFTER > redirection. command &>/dev/null discards both stdout and stderr.","updatedAt":"2026-03-03T04:02:32.928Z"},{"_id":"69a65d58ff996647cc9a6c8c","command":"alias","category":"Shell / Terminal","description":"Create shorthand for commands. Add to ~/.bashrc or ~/.zshrc.","examples":["alias ll='ls -lah --color=auto'","alias gs='git status'","alias k='kubectl'","alias dps='docker ps --format \"table {{.Names}}\\t{{.Status}}\\t{{.Ports}}\"'","unalias ll  # remove alias"],"flags":[],"synopsis":"alias NAME=\"COMMAND\"","tip":"Run alias without arguments to see all defined aliases.","updatedAt":"2026-03-03T04:02:32.975Z"},{"_id":"69a65d59ff996647cc9a6c8d","command":"trap","category":"Shell / Terminal","description":"Execute a command when a signal is received. Essential for cleanup in scripts.","examples":["trap \"rm -f /tmp/myapp.lock; exit\" INT TERM EXIT","trap \"echo Interrupted\" INT","trap - INT  # reset to default"],"flags":[],"synopsis":"trap \"CMD\" SIGNAL","tip":"trap \"cleanup\" EXIT runs cleanup even on normal exit — use for temp file removal.","updatedAt":"2026-03-03T04:02:33.014Z"},{"_id":"69a65d59ff996647cc9a6c8e","command":"git","category":"Development Tools","description":"Core git commands and flags for daily use.","examples":["git log --oneline --graph --all","git diff HEAD~1 HEAD -- path/to/file","git stash list && git stash apply stash@{0}","git bisect start && git bisect bad && git bisect good v1.0"],"flags":[{"flag":"log --oneline --graph","meaning":"Pretty commit tree"},{"flag":"stash / stash pop","meaning":"Temporarily shelve changes"},{"flag":"diff HEAD~1","meaning":"Diff vs last commit"},{"flag":"reset --soft HEAD~1","meaning":"Undo commit, keep changes staged"},{"flag":"reset --hard HEAD","meaning":"Discard all local changes"},{"flag":"cherry-pick HASH","meaning":"Apply specific commit to current branch"},{"flag":"bisect start/bad/good","meaning":"Binary search for bug-introducing commit"},{"flag":"reflog","meaning":"History of all HEAD movements — recover lost commits"}],"synopsis":"git COMMAND [OPTIONS]","tip":"git reflog is your safety net — recovers commits even after reset --hard.","updatedAt":"2026-03-03T04:02:33.058Z"},{"_id":"69a65d59ff996647cc9a6c8f","command":"make","category":"Development Tools","description":"Build automation tool that reads Makefile. Tracks dependencies via timestamps.","examples":["make -j$(nproc)  # use all CPU cores","make -n install  # see what install does","make clean && make -j8"],"flags":[{"flag":"-j8","meaning":"Parallel builds with 8 jobs"},{"flag":"-n","meaning":"Dry run (print commands only)"},{"flag":"-B","meaning":"Force rebuild all targets"},{"flag":"-C dir","meaning":"Run make in directory dir"},{"flag":"--debug","meaning":"Debug dependency resolution"},{"flag":"-f FILE","meaning":"Use alternate Makefile"}],"synopsis":"make [OPTIONS] [TARGET]","tip":"$(nproc) returns the number of available CPU cores — use it with -j for max parallelism.","updatedAt":"2026-03-03T04:02:33.100Z"},{"_id":"69a65d59ff996647cc9a6c90","command":"gdb","category":"Development Tools","description":"GNU Debugger — inspect running programs, set breakpoints, examine memory.","examples":["gdb ./myapp core","gdb -p $(pgrep myapp)","gdb ./myapp --batch -ex \"run\" -ex \"bt full\" -ex \"quit\""],"flags":[{"flag":"-p PID","meaning":"Attach to running process"},{"flag":"--batch -ex \"CMD\"","meaning":"Non-interactive: run command and exit"},{"flag":"-tui","meaning":"Text UI with source view"},{"flag":"--core COREFILE","meaning":"Analyze core dump"}],"synopsis":"gdb [OPTIONS] PROGRAM [CORE]","tip":"GDB commands: b main (breakpoint), r (run), n (next), s (step into), bt (backtrace), p var (print), x/10x addr (examine memory), q (quit).","updatedAt":"2026-03-03T04:02:33.145Z"},{"_id":"69a65d59ff996647cc9a6c91","command":"perf","category":"Development Tools","description":"Linux performance analysis tool — CPU profiling, cache misses, branch mispredictions.","examples":["perf stat -e cache-misses,cache-references ./myapp","perf record -g ./myapp && perf report","perf stat -r 5 ./myapp  # repeat 5 times, average"],"flags":[{"flag":"stat CMD","meaning":"Count hardware events while running CMD"},{"flag":"top","meaning":"Interactive real-time profiling"},{"flag":"record -g CMD","meaning":"Record call graph profile"},{"flag":"report","meaning":"Analyze recorded data"},{"flag":"list","meaning":"List available event types"}],"synopsis":"perf SUBCOMMAND [OPTIONS]","tip":"\"perf stat\" in 2 seconds tells you if you are CPU-bound, cache-bound, or branch-prediction-bound.","updatedAt":"2026-03-03T04:02:33.192Z"},{"_id":"69a65d59ff996647cc9a6c92","command":"objdump","category":"Development Tools","description":"Display information from object files — disassembly, sections, symbols.","examples":["objdump -d myapp | grep -A5 \"<main>\"","objdump -S myapp > disasm.txt","nm myapp | grep \" T \"  # list text (code) symbols"],"flags":[{"flag":"-d","meaning":"Disassemble executable sections"},{"flag":"-D","meaning":"Disassemble all sections"},{"flag":"-S","meaning":"Interleave source with disassembly"},{"flag":"-t","meaning":"Symbol table"},{"flag":"-h","meaning":"Section headers"},{"flag":"-j .text","meaning":"Operate on specific section"}],"synopsis":"objdump [OPTIONS] FILE","tip":"objdump -M intel -d file shows AT&T vs Intel syntax. Pair with addr2line to resolve addresses.","updatedAt":"2026-03-03T04:02:33.241Z"},{"_id":"69a65d59ff996647cc9a6c93","command":"stdbuf","category":"Development Tools","description":"Modify buffering mode for standard streams. Useful when piping real-time output.","examples":["stdbuf -oL ./myapp | grep \"error\"","stdbuf -o0 tail -f app.log | grep --line-buffered \"FAIL\""],"flags":[{"flag":"-oL","meaning":"Line-buffered stdout"},{"flag":"-o0","meaning":"Unbuffered stdout"},{"flag":"-e0","meaning":"Unbuffered stderr"}],"synopsis":"stdbuf [OPTIONS] COMMAND","tip":"When piped output seems \"stuck\", add stdbuf -oL to force line-by-line flushing.","updatedAt":"2026-03-03T04:02:33.281Z"},{"_id":"69a65d59ff996647cc9a6c94","command":"rg (ripgrep)","category":"Productivity Tools","description":"Ultra-fast grep replacement that respects .gitignore and uses multiple CPU cores.","examples":["rg \"TODO\" --type py","rg -l \"import numpy\"","rg -n \"def.*forward\" --type py -A3","rg \"CUDA\" --type cpp --stats"],"flags":[{"flag":"-i","meaning":"Case-insensitive"},{"flag":"-n","meaning":"Show line numbers"},{"flag":"-l","meaning":"Filenames only"},{"flag":"-A/-B/-C N","meaning":"Context lines after/before/both"},{"flag":"--type py","meaning":"Only search Python files"},{"flag":"-w","meaning":"Whole word match"},{"flag":"--hidden","meaning":"Search hidden files"},{"flag":"-e PATTERN","meaning":"Multiple patterns (OR)"},{"flag":"--no-ignore","meaning":"Search gitignored files too"}],"synopsis":"rg [OPTIONS] PATTERN [PATH]","tip":"rg is 10-100x faster than grep on large codebases. Use rg --type-list to see all type names.","updatedAt":"2026-03-03T04:02:33.324Z"},{"_id":"69a65d59ff996647cc9a6c95","command":"fd","category":"Productivity Tools","description":"Simple, fast alternative to find. Respects .gitignore by default.","examples":["fd -e log -x rm  # delete all .log files","fd -t f -e py | xargs wc -l","fd \"config\" /etc --type f"],"flags":[{"flag":"-e py","meaning":"Filter by extension"},{"flag":"-t f / -t d","meaning":"Files / directories"},{"flag":"-H","meaning":"Include hidden files"},{"flag":"-I","meaning":"Include gitignored files"},{"flag":"-x CMD","meaning":"Execute command for each result"},{"flag":"--max-depth N","meaning":"Limit depth"}],"synopsis":"fd [OPTIONS] PATTERN [PATH]","tip":"fd is to find what rg is to grep — faster, prettier, smarter defaults.","updatedAt":"2026-03-03T04:02:33.370Z"},{"_id":"69a65d59ff996647cc9a6c96","command":"bat","category":"Productivity Tools","description":"cat clone with syntax highlighting, line numbers, and git diff integration.","examples":["bat /etc/nginx/nginx.conf","bat --diff HEAD~1:file.py file.py","cat large.json | python3 -m json.tool | bat -l json"],"flags":[{"flag":"-n","meaning":"Show line numbers only"},{"flag":"-A","meaning":"Show non-printable characters"},{"flag":"--plain","meaning":"No decorations (pure color only)"},{"flag":"-l LANG","meaning":"Force language syntax"},{"flag":"--diff","meaning":"Show only changed lines (git)"}],"synopsis":"bat [OPTIONS] FILE","tip":"alias cat=\"bat\" for an instant upgrade. Use --plain in scripts where you still need raw output.","updatedAt":"2026-03-03T04:02:33.413Z"},{"_id":"69a65d59ff996647cc9a6c97","command":"htop","category":"Productivity Tools","description":"Interactive process viewer with color, tree view, and mouse support. Better top.","examples":["htop -u $USER","htop -p $(pgrep python3 | tr \"\\n\" \",\")"],"flags":[{"flag":"-u USER","meaning":"Filter by user"},{"flag":"-p PID1,PID2","meaning":"Monitor specific PIDs"},{"flag":"-d 5","meaning":"Refresh every 5 tenths of a second"},{"flag":"--tree","meaning":"Start in tree view"}],"synopsis":"htop","tip":"htop keys: F5=tree, F6=sort, F9=kill, F10=quit, /=filter, u=user filter, t=tree toggle.","updatedAt":"2026-03-03T04:02:33.458Z"},{"_id":"69a65d59ff996647cc9a6c98","command":"eza","category":"Productivity Tools","description":"Modern ls replacement with icons, git status, and tree view.","examples":["eza -lah --git","eza --tree --level=2","alias ls=\"eza --icons --git\""],"flags":[{"flag":"-l","meaning":"Long format"},{"flag":"-a","meaning":"Show hidden"},{"flag":"--git","meaning":"Show git status"},{"flag":"--tree","meaning":"Tree view"},{"flag":"-L N","meaning":"Tree depth N"},{"flag":"--icons","meaning":"Show file type icons (needs Nerd Font)"}],"synopsis":"eza [OPTIONS] [PATH]","tip":"eza --tree --level=2 --git replaces the tree command with richer info.","updatedAt":"2026-03-03T04:02:33.501Z"},{"_id":"69a65d59ff996647cc9a6c99","command":"jc","category":"Productivity Tools","description":"Convert output of popular commands to JSON for scripting.","examples":["jc ps aux | jq \".[] | select(.cpu_percent > 5)\"","jc df -h | jq \".[] | {fs: .filesystem, use: .use_percent}\"","jc ls -la | jq \".[] | select(.name | startswith(\".\"))\""],"flags":[],"synopsis":"jc COMMAND","tip":"jc works with: ps, df, ls, ifconfig, netstat, ping, uname, dig, git, and many more.","updatedAt":"2026-03-03T04:02:33.541Z"},{"_id":"69a65d59ff996647cc9a6c9a","command":"parallel","category":"Productivity Tools","description":"GNU Parallel — run jobs in parallel on multiple CPU cores.","examples":["parallel -j4 \"convert {} {.}.png\" ::: *.jpg","cat urls.txt | parallel -j8 wget","ls *.py | parallel -j$(nproc) python3 {}"],"flags":[{"flag":"-j N","meaning":"Number of parallel jobs"},{"flag":"--bar","meaning":"Show progress bar"},{"flag":"-I{}","meaning":"Replace {} with argument"},{"flag":"--eta","meaning":"Estimated time of completion"},{"flag":"--dry-run","meaning":"Print commands without running"}],"synopsis":"parallel [OPTIONS] COMMAND ::: ARGS","tip":"parallel is like xargs -P but smarter — proper quoting, progress, and ETA.","updatedAt":"2026-03-03T04:02:33.588Z"}]